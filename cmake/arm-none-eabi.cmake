set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_C_COMPILER arm-none-eabi-gcc)
set(CMAKE_ASM_COMPILER arm-none-eabi-gcc)
set(CMAKE_CXX_COMPILER arm-none-eabi-g++)
set(CMAKE_OBJCOPY arm-none-eabi-objcopy)
set(CMAKE_SIZE arm-none-eabi-size)
set(CMAKE_EXECUTABLE_SUFFIX_C .elf)
set(CMAKE_EXECUTABLE_SUFFIX_ASM .elf)
set(SHARK_CPU_FLAGS "-mcpu=cortex-m4 -mthumb -mfpu=fpv4-sp-d16 -mfloat-abi=hard")
set(CMAKE_C_FLAGS_INIT "${SHARK_CPU_FLAGS} -Wall -ffunction-sections -fdata-sections -fstack-usage")
set(CMAKE_ASM_FLAGS_INIT "${SHARK_CPU_FLAGS} -x assembler-with-cpp")
set(CMAKE_C_FLAGS_DEBUG_INIT "-Og -g3")
set(CMAKE_C_FLAGS_RELEASE_INIT "-Os -g0")
get_filename_component(SHARK_LINKER_SCRIPT "${CMAKE_CURRENT_LIST_DIR}/../uart_to_can/STM32G431xx_FLASH.ld" ABSOLUTE)
set(CMAKE_EXE_LINKER_FLAGS_INIT "${SHARK_CPU_FLAGS} -T\"${SHARK_LINKER_SCRIPT}\" --specs=nano.specs -Wl,--gc-sections,--print-memory-usage")
set(TOOLCHAIN_LINK_LIBRARIES m)
