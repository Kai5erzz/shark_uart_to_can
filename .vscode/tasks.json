{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Regenerate (CubeMX)",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "${workspaceFolder}/tools/regenerate.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "CMake Configure",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "Debug"
      ],
      "dependsOn": "CMake Configure",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Flash (DAPLink)",
      "type": "process",
      "command": "openocd",
      "args": [
        "-f",
        "${workspaceFolder}/openocd/daplink_stm32g4.cfg",
        "-c",
        "shark_program {build/Debug/uart_to_can/uart_to_can.elf}"
      ],
      "dependsOn": "Build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Build Release",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "Release"
      ],
      "dependsOn": "Configure Release",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Configure Release",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "Release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Serial Assistant",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "${workspaceFolder}/tools/serial_assistant.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "CH340 / CDC Self Test",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "${workspaceFolder}/tools/serial_assistant.py",
        "--port",
        "${input:serialPort}",
        "--self-test",
        "--can-loopback"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Binary / CAN Self Test",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "${workspaceFolder}/tools/serial_assistant.py",
        "--port",
        "${input:serialPort}",
        "--binary-test",
        "--can-loopback"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Serial Latency / Throughput",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "${workspaceFolder}/tools/serial_assistant.py",
        "--port",
        "${input:serialPort}",
        "--benchmark",
        "--rounds",
        "1000",
        "--size",
        "64"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "USB - USART1 Full Duplex Test",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "${workspaceFolder}/tools/serial_assistant.py",
        "--port",
        "${input:usbPort}",
        "--peer",
        "${input:uart1Port}",
        "--bridge-test",
        "--rounds",
        "1000"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Host Tests",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/tools/test_host.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Flash Release (DAPLink)",
      "type": "process",
      "command": "openocd",
      "args": [
        "-f",
        "${workspaceFolder}/openocd/daplink_stm32g4.cfg",
        "-c",
        "shark_program {build/Release/uart_to_can/uart_to_can.elf}"
      ],
      "dependsOn": "Build Release",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Repair Boot Option (DAPLink)",
      "type": "process",
      "command": "openocd",
      "args": [
        "-f",
        "${workspaceFolder}/openocd/daplink_stm32g4.cfg",
        "-c",
        "shark_fix_boot"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "CAN Monitor",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "${workspaceFolder}/tools/can_monitor/app.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Package Project",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "${workspaceFolder}/tools/package_project.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "serialPort",
      "type": "promptString",
      "description": "CH340 / USB CDC port, e.g. /dev/ttyUSB0, /dev/ttyACM0 or COM5",
      "default": "/dev/ttyUSB0"
    },
    {
      "id": "usbPort",
      "type": "promptString",
      "description": "Native USB CDC port (board already in usb-ttl mode)",
      "default": "/dev/ttyACM0"
    },
    {
      "id": "uart1Port",
      "type": "promptString",
      "description": "CH340 / USART1 adapter port",
      "default": "/dev/ttyUSB0"
    }
  ]
}
